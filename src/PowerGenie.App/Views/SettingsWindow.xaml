<Window x:Class="PowerGenie.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerGenie.App.Views"
        Title="Power Genie Settings" Height="600" Width="660" MinHeight="540" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" Margin="0,0,6,0" BorderBrush="Gray" BorderThickness="1"
                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="GlyphItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Preview}" Width="16" Height="16" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Default power plan:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DefaultPlanComboBox" Width="260" DisplayMemberPath="Name" SelectionChanged="DefaultPlanComboBox_SelectionChanged"/>
            <Button x:Name="SyncPlansButton" Content="Sync power plans" Width="120" Margin="8,0,0,0" Click="SyncPlansButton_Click"
                    ToolTip="The list of power plans is checked once a day automatically. Just created or deleted one in Windows? Click here to see it right away."/>
        </StackPanel>

        <DataGrid x:Name="RulesGrid" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Power Plan" Binding="{Binding PlanName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,8,0,0">
            <Button x:Name="AddRuleButton" Content="Add rule" Width="90" Margin="0,0,8,0" Click="AddRuleButton_Click"/>
            <Button x:Name="EditRuleButton" Content="Edit rule" Width="90" Margin="0,0,8,0" Click="EditRuleButton_Click"/>
            <Button x:Name="RemoveRuleButton" Content="Remove rule" Width="90" Click="RemoveRuleButton_Click"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,16,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tray icons, picked automatically by performance level. Change any you like:" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="EditPlansButton" Grid.Column="1" Content="Edit power plans" Padding="10,2" Click="EditPlansButton_Click"
                    ToolTip="Open Windows Power Options to create, rename or change power plans."/>
        </Grid>

        <StackPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Plan" Width="190" Foreground="Gray"/>
                <TextBlock Text="Dot color" Width="108" Margin="36,0,0,0" Foreground="Gray"/>
                <TextBlock Text="Symbol" Width="118" Foreground="Gray"/>
                <TextBlock Text="Symbol color" Width="108" Foreground="Gray"/>
            </StackPanel>
            <!-- Bounded: sizes to content for a few plans, scrolls internally past ~6 rows. -->
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PlanColorsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="{Binding PlanName}" Width="190" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding PlanName}"/>
                                <Image Source="{Binding Preview}" Width="24" Height="24" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding DotColor, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource ColorItemTemplate}" Width="100" Margin="0,0,8,0"
                                          SelectionChanged="PlanIconComboBox_SelectionChanged"/>
                                <ComboBox ItemsSource="{Binding GlyphOptions}" SelectedItem="{Binding Glyph, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource GlyphItemTemplate}" Width="110" Margin="0,0,8,0"
                                          SelectionChanged="PlanIconComboBox_SelectionChanged"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding GlyphColor, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource ColorItemTemplate}" Width="100"
                                          SelectionChanged="PlanIconComboBox_SelectionChanged"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="5" Margin="0,16,0,0" HorizontalAlignment="Right">
            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" VerticalAlignment="Center" Margin="0,0,16,0"
                      Checked="StartWithWindowsCheckBox_CheckedChanged" Unchecked="StartWithWindowsCheckBox_CheckedChanged"/>
            <Button x:Name="SaveButton" Content="Save" Width="90" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
