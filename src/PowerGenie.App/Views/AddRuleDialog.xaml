<Window x:Class="PowerGenie.App.Views.AddRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add rule" Height="470" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <!-- Edit mode: a plain single-select list. -->
        <DataTemplate x:Key="PlainRowTemplate">
            <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>

        <!-- Add mode: each row shows a checkbox mirroring the row's selection state. The checkbox
             itself is not clickable; the click lands on the ListBoxItem, so the ListBox's own
             Multiple-mode selection (plain click toggles, Shift-click ranges, Ctrl-click toggles)
             stays the single source of truth. -->
        <DataTemplate x:Key="CheckRowTemplate">
            <CheckBox Content="{Binding DisplayName}" IsHitTestVisible="False" Focusable="False"
                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <ComboBox x:Name="SearchSourceComboBox" Width="140" SelectionChanged="SearchSourceComboBox_SelectionChanged"/>
            <TextBox x:Name="SearchTextBox" Width="296" Margin="8,0,0,0"
                     VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"/>
        </StackPanel>

        <ListBox x:Name="ResultsListBox" Grid.Row="1"
                 SelectionMode="Multiple" SelectionChanged="ResultsListBox_SelectionChanged"/>

        <!-- Hint when nothing is selected, live count otherwise; hidden in edit mode. -->
        <Grid x:Name="SelectionStatusPanel" Grid.Row="2" Margin="0,6,0,0" MinHeight="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionStatusText" Foreground="Gray" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <Hyperlink Click="SelectAllShownLink_Click">Select all shown</Hyperlink>
                <Run Text=" "/>
                <Hyperlink x:Name="ClearSelectionLink" Click="ClearSelectionLink_Click">Clear</Hyperlink>
            </TextBlock>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="or a direct path:" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="ManualPathTextBox" Width="260" TextChanged="ManualPathTextBox_TextChanged"/>
            <Button x:Name="BrowseButton" Content="Browse..." Width="80" Margin="8,0,0,0" Click="BrowseButton_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Display name:" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="DisplayNameTextBox" Width="260" TextChanged="DisplayNameTextBox_TextChanged"/>
            <TextBlock x:Name="MultiSelectionNoticeText" Width="260" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="Gray" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="5" Margin="0,8,0,0">
            <TextBlock Text="Power plan:" VerticalAlignment="Center" Width="90"/>
            <ComboBox x:Name="PlanComboBox" Width="260" DisplayMemberPath="Name" SelectionChanged="PlanComboBox_SelectionChanged"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="6" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Content="Add rule" MinWidth="80" Padding="10,0" IsEnabled="False" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
